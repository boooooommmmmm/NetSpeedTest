<Window x:Class="NetPulse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NetPulse" Title="NetPulse · 网络测速与波动监测" Icon="Assets/NetPulse.App.ico" Width="1160" Height="930" MinWidth="940" MinHeight="700" Background="#0B1220" Foreground="#EAF1FC" FontFamily="Microsoft YaHei UI, Segoe UI" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,20,26,18">
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource NetPulseIcon}" Width="44" Height="44" Margin="0,0,13,0" /><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="NetPulse" FontSize="25" FontWeight="Bold" /><TextBlock Text="网络脉搏" Margin="12,10,0,0" Foreground="{StaticResource Muted}" /></StackPanel><TextBlock Text="测速度，看延迟，发现每一次网络波动。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" /></StackPanel></StackPanel>
        <Border Grid.Column="1" Background="#142C2A" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="{Binding VersionBadge}" Foreground="#76DFC0" FontSize="11" /></Border>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="检查更新" Click="CheckUpdates_Click" IsEnabled="{Binding CanCheckUpdates}" Padding="10,7" Margin="0,0,6,0" /><Button Content="{Binding DownloadUpdateText}" Click="DownloadUpdate_Click" IsEnabled="{Binding UpdateDownloadButtonEnabled}" Padding="10,7" Margin="0,0,6,0" /><Button Content="发布说明" Click="ReleaseNotes_Click" Padding="10,7" /></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="#79AFFF" TextWrapping="Wrap" /><WrapPanel><CheckBox x:Name="AutoUpdateCheckBox" Content="每 6 小时检查更新" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" Margin="0,6,16,0" /><CheckBox x:Name="AutoInstallCheckBox" Content="空闲时自动安装并重启" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" Margin="0,6,0,0" ToolTip="监测、测速或本次还有测试记录时顺延；也可手动点击更新并重启，记录会先自动备份。" /></WrapPanel></StackPanel></DockPanel></Border>

      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14"><StackPanel>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="测速源" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><ComboBox x:Name="SourceBox" SelectedIndex="3" SelectionChanged="Source_Changed" IsEnabled="{Binding SourceSettingsEnabled}"><ComboBoxItem Content="测速网 SpeedTest.cn · 国内" /><ComboBoxItem Content="Cloudflare · 国际对照" /><ComboBoxItem Content="自定义 HTTP 节点" /><ComboBoxItem Content="Speedtest.net · Ookla 节点" /></ComboBox></StackPanel>
          <StackPanel Grid.Column="1" Visibility="{Binding NodePickerVisibility}" Margin="0,0,10,0"><TextBlock Text="{Binding NodePickerLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><ComboBox x:Name="NodeBox" DisplayMemberPath="DisplayName" SelectionChanged="Node_Changed" IsEnabled="{Binding SourceSettingsEnabled}" AutomationProperties.Name="测速节点" /></StackPanel>
          <Button Grid.Column="2" Content="立即同步" Click="RefreshNodes_Click" IsEnabled="{Binding SourceSettingsEnabled}" Margin="0,19,0,0" />
        </Grid>
        <TextBlock Text="{Binding NodeStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center"><CheckBox x:Name="AutoSyncBox" Content="{Binding AutoSyncLabel}" IsChecked="True" Checked="SyncSettings_Changed" Unchecked="SyncSettings_Changed" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding SourceSettingsEnabled}" /><TextBlock Text="每" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" /><ComboBox x:Name="SyncIntervalBox" Width="110" SelectedIndex="1" SelectionChanged="SyncSettings_Changed" IsEnabled="{Binding SourceSettingsEnabled}"><ComboBoxItem Content="5 分钟" Tag="5" /><ComboBoxItem Content="15 分钟" Tag="15" /><ComboBoxItem Content="30 分钟" Tag="30" /><ComboBoxItem Content="60 分钟" Tag="60" /></ComboBox><TextBlock Text="仅更新节点和 IP，不自动进行下载 / 上传测速" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" /></WrapPanel>
        <TextBlock Text="{Binding SyncStatus}" Foreground="#79AFFF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9" />
        <Expander x:Name="SyncedNodesExpander" Header="{Binding SyncedNodesHeader}" Margin="0,0,0,14"><ListView ItemsSource="{Binding SyncedIpRows}" Height="150" Background="#0C1627" Foreground="#CCDAED" BorderBrush="#25344A" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontSize="11"><ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#192940" /><Setter Property="Foreground" Value="#9DB2CF" /><Setter Property="Padding" Value="6,5" /><Setter Property="BorderThickness" Value="0" /></Style></ListView.Resources><ListView.View><GridView><GridViewColumn Header="节点 / 地区" DisplayMemberBinding="{Binding Name}" Width="280" /><GridViewColumn Header="域名" DisplayMemberBinding="{Binding Host}" Width="330" /><GridViewColumn Header="解析出的 IP" DisplayMemberBinding="{Binding Addresses}" Width="280" /><GridViewColumn Header="HTTP 探测" DisplayMemberBinding="{Binding Latency}" Width="100" /></GridView></ListView.View></ListView></Expander>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="118" /><ColumnDefinition Width="76" /><ColumnDefinition Width="85" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="监测目标 · IP / 域名" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><DockPanel><Button Content="网关" Click="Gateway_Click" Padding="10,7" DockPanel.Dock="Right" Margin="6,0,0,0" IsEnabled="{Binding MonitorSettingsEnabled}" ToolTip="自动填入当前网卡的 IPv4 网关" /><TextBox x:Name="TargetBox" Text="223.5.5.5" IsEnabled="{Binding MonitorSettingsEnabled}" AutomationProperties.Name="监测目标" /></DockPanel></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="探测方式" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><ComboBox x:Name="ModeBox" SelectedIndex="0" IsEnabled="{Binding MonitorSettingsEnabled}"><ComboBoxItem Content="ICMP Ping" /><ComboBoxItem Content="TCP 连接" /></ComboBox></StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="TCP 端口" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><TextBox x:Name="PortBox" Text="443" IsEnabled="{Binding MonitorSettingsEnabled}" AutomationProperties.Name="TCP端口" /></StackPanel>
          <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="间隔" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" /><ComboBox x:Name="IntervalBox" SelectedIndex="1" IsEnabled="{Binding MonitorSettingsEnabled}"><ComboBoxItem Content="0.5 秒" Tag="500" /><ComboBoxItem Content="1 秒" Tag="1000" /><ComboBoxItem Content="2 秒" Tag="2000" /></ComboBox></StackPanel>
          <Button Grid.Column="4" Content="{Binding MonitorButtonText}" Click="Monitor_Click" Margin="0,19,8,0" MinWidth="104" />
          <Button Grid.Column="5" Content="{Binding SpeedButtonText}" Style="{StaticResource PrimaryButton}" Click="Speed_Click" Margin="0,19,0,0" MinWidth="110" />
        </Grid>
        <Expander Header="测速设置与自定义节点" Margin="0,12,0,0"><StackPanel Margin="4,12,4,0" IsEnabled="{Binding SpeedSettingsEnabled}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="每项时长" Foreground="{StaticResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="DurationBox" SelectedIndex="1"><ComboBoxItem Content="5 秒" Tag="5" /><ComboBoxItem Content="10 秒" Tag="10" /><ComboBoxItem Content="20 秒" Tag="20" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="并发连接" Foreground="{StaticResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="ConnectionsBox" SelectedIndex="1"><ComboBoxItem Content="2 条" Tag="2" /><ComboBoxItem Content="4 条" Tag="4" /><ComboBoxItem Content="8 条" Tag="8" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="每项流量上限" Foreground="{StaticResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="LimitBox" SelectedIndex="1"><ComboBoxItem Content="64 MiB" Tag="64" /><ComboBoxItem Content="256 MiB" Tag="256" /><ComboBoxItem Content="1024 MiB" Tag="1024" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="探测超时" Foreground="{StaticResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="TimeoutBox" SelectedIndex="1" IsEnabled="{Binding MonitorSettingsEnabled}"><ComboBoxItem Content="1 秒" Tag="1000" /><ComboBoxItem Content="2 秒" Tag="2000" /><ComboBoxItem Content="3 秒" Tag="3000" /></ComboBox></StackPanel>
            <CheckBox Grid.Column="4" x:Name="ProxyBox" Content="使用系统代理测速" Checked="SyncSettings_Changed" Unchecked="SyncSettings_Changed" VerticalAlignment="Bottom" Margin="0,0,0,10" ToolTip="默认直接连接；勾选后 HTTP 测速和节点同步使用系统代理。系统级 VPN / TUN 仍可能影响所有流量。" />
          </Grid>
          <TextBlock Text="下载 URL（GET 二进制内容；预设源自动填写，选择自定义后可编辑）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,5" /><TextBox x:Name="DownloadUrlBox" IsReadOnly="{Binding EndpointsReadOnly}" />
          <TextBlock Text="上传 URL（POST 原始二进制；自定义源可留空，仅测试下载）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,5" /><TextBox x:Name="UploadUrlBox" IsReadOnly="{Binding EndpointsReadOnly}" />
          <TextBlock Text="默认使用 Speedtest.net 公开节点；也可选择测速网或 Cloudflare。采用 HTTP 测量，结果受节点、路由、代理和负载影响。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel></Expander>
      </StackPanel></Border>

      <UniformGrid Columns="4" Margin="0,0,-10,14">
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="↓  下载速度" Foreground="#56DDB7" /><StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{Binding DownloadValue}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,7" FontSize="11" /></StackPanel><TextBlock Text="{Binding DownloadHint}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="↑  上传速度" Foreground="#79AFFF" /><StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{Binding UploadValue}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,7" FontSize="11" /></StackPanel><TextBlock Text="{Binding UploadHint}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="◎  当前延迟" Foreground="#D5E2F6" /><StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{Binding LatencyValue}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="ms" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,7" FontSize="11" /></StackPanel><TextBlock Text="{Binding AverageHint}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="≈  延迟抖动" Foreground="#E9C58A" /><StackPanel Orientation="Horizontal" Margin="0,8,0,3"><TextBlock Text="{Binding JitterValue}" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="ms" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="7,0,0,7" FontSize="11" /></StackPanel><TextBlock Text="{Binding LossHint}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      </UniformGrid>

      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="延迟波动" FontWeight="SemiBold" /><TextBlock Text="最近 180 次探测 · 红线为失败" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" /></DockPanel><local:NetworkPlot x:Name="LatencyPlot" Height="187" Margin="0,14,0,0" Unit="ms" /><TextBlock Text="{Binding RangeHint}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" /></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="测试状态" FontWeight="SemiBold" /><TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11" /></DockPanel><TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#56DDB7" Margin="0,16,0,8" TextWrapping="Wrap" /><ProgressBar Value="{Binding ProgressValue}" Maximum="100" Margin="0,0,0,10" /><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" MinHeight="32" /><local:NetworkPlot x:Name="SpeedPlot" Height="73" Unit="Mbps" EmptyText="测速时显示实时吞吐" Margin="0,7,0,6" /><TextBlock Text="{Binding TrafficText}" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="清空记录" Click="Clear_Click" IsEnabled="{Binding CanClear}" Padding="11,6" Margin="0,0,7,0" /><Button Content="导出 CSV" Click="Export_Click" IsEnabled="{Binding HasSamples}" Padding="11,6" /></StackPanel><StackPanel><TextBlock Text="探测记录" FontWeight="SemiBold" /><TextBlock Text="{Binding SampleCountText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel></DockPanel>
        <ListView x:Name="SampleList" ItemsSource="{Binding RecentSamples}" Height="135" Background="Transparent" BorderThickness="0" Foreground="#CCDAED" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="11">
          <ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#192940" /><Setter Property="Foreground" Value="#9DB2CF" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6,5" /></Style><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2C425E" /></Trigger></Style.Triggers></Style></ListView.Resources>
          <ListView.View><GridView><GridViewColumn Header="时间" DisplayMemberBinding="{Binding Time}" Width="90" /><GridViewColumn Header="目标" DisplayMemberBinding="{Binding Target}" Width="185" /><GridViewColumn Header="方式" DisplayMemberBinding="{Binding Mode}" Width="75" /><GridViewColumn Header="负载" DisplayMemberBinding="{Binding Phase}" Width="85" /><GridViewColumn Header="延迟" DisplayMemberBinding="{Binding Latency}" Width="90" /><GridViewColumn Header="结果 / 详情" DisplayMemberBinding="{Binding Detail}" Width="430" /></GridView></ListView.View>
        </ListView>
      </StackPanel></Border>
      <TextBlock Text="测速会产生实际流量，默认每项最多 256 MiB。Ping 无回应也可能是目标禁用 ICMP；可改用 TCP 并选择开放的端口。" Foreground="#8196B3" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
